{
  "name": "@zakkster/lite-audio-pool",
  "version": "1.4.0",
  "description": "Zero-GC Web Audio sound sprite pool. Voice stealing with 20ms anti-pop fade, pitch shifting, stereo, positional, HRTF, or discrete surround pan.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./AudioPool.js",
  "types": "./AudioPool.d.ts",
  "module": "./AudioPool.js",
  "exports": {
    ".": {
      "types": "./AudioPool.d.ts",
      "node": "./AudioPool.js",
      "import": "./AudioPool.js",
      "default": "./AudioPool.js"
    }
  },
  "files": [
    "AudioPool.js",
    "AudioPool.d.ts",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "DECISIONS.md"
  ],
  "keywords": [
    "audio",
    "sound",
    "sprite",
    "pool",
    "webaudio",
    "zero-gc",
    "voice-stealing",
    "aba-safe",
    "generation-handles"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/PeshoVurtoleta/lite-audio-pool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-audio-pool.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-audio-pool/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bench": "node --expose-gc bench/torture.js"
  }
}